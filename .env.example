# Copy to .env and fill in. Never commit the real .env.
DB_URL=jdbc:postgresql://localhost:5432/tdc
DB_USERNAME=tdc
DB_PASSWORD=change-me
# At least 32 characters, e.g. the output of: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads
# Optional first admin, created on startup if the user doesn't exist yet
ADMIN_USERNAME=
ADMIN_PASSWORD=
